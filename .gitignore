# Dependencies and downloaded runtimes
node_modules/
package-lock.json.tmp*

# Build output
dist/
*.AppImage
*.deb

# Personal/runtime data -- never belongs in source control
logs/*
!logs/README.txt
backups/
Hive Wrapped Data/
User Data Backup/
MusicBeeWrapped/
.beehive-installed
BUILD
# The portable-mode data root (library DB, covers cache, cookies, crash
# dumps, compiled native helper binary, Discord presence config, etc.) --
# added after the build258 portable-data-root migration, which predates
# this .gitignore entry.
Hive Data/

# Editor/OS noise
.DS_Store
*.swp

# Local env/secrets
.env
*.pem
*.key
